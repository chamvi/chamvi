{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "include-component-in-tag": false,
    "release-type": "node",
    "bump-minor-pre-major": true,
    "bump-patch-for-minor-pre-major": true,
    "initial-version": "0.1.0",
    "packages": {
        ".": {"component": "root"},
        "packages/access": {"component": "access"},
        "packages/app": {"component": "app"},
        "packages/channel-cron": {"component": "channel-cron"},
        "packages/channel-openclaw": {"component": "channel-openclaw"},
        "packages/chat": {"component": "chat"},
        "packages/chat-discord": {"component": "chat-discord"},
        "packages/chat-whatsapp": {"component": "chat-whatsapp"},
        "packages/cli": {"component": "cli"},
        "packages/coding": {"component": "coding"},
        "packages/core": {"component": "core"},
        "packages/github": {"component": "github"},
        "packages/http": {"component": "http"},
        "packages/knowledge": {"component": "knowledge"},
        "packages/sandbox": {"component": "sandbox"},
        "packages/sandbox-docker": {"component": "sandbox-docker"},
        "packages/sandbox-k8s": {"component": "sandbox-k8s"},
        "packages/sandbox-local": {"component": "sandbox-local"},
        "packages/skills": {"component": "skills"},
        "packages/store-db": {"component": "store-db"},
        "packages/test-kit": {"component": "test-kit"},
        "packages/tool-calendar": {"component": "tool-calendar"},
        "packages/tool-files": {"component": "tool-files"},
        "packages/tool-mail": {"component": "tool-mail"},
        "packages/tool-utils": {"component": "tool-utils"},
        "packages/tool-web": {"component": "tool-web"},
        "packages/ui": {"component": "ui"},
        "packages/ui-kit": {"component": "ui-kit"},
        "packages/tool-mail-ui": {"component": "tool-mail-ui"},
        "packages/tool-calendar-ui": {"component": "tool-calendar-ui"},
        "packages/github-ui": {"component": "github-ui"},
        "packages/chat-discord-ui": {"component": "chat-discord-ui"},
        "packages/chat-whatsapp-ui": {"component": "chat-whatsapp-ui"}
    },
    "plugins": [
        {
            "type": "linked-versions",
            "groupName": "main",
            "merge": false,
            "components": [
                "root",
                "access",
                "app",
                "channel-cron",
                "channel-openclaw",
                "chat",
                "chat-discord",
                "chat-whatsapp",
                "cli",
                "coding",
                "core",
                "github",
                "http",
                "knowledge",
                "sandbox",
                "sandbox-docker",
                "sandbox-k8s",
                "sandbox-local",
                "skills",
                "store-db",
                "test-kit",
                "tool-calendar",
                "tool-files",
                "tool-mail",
                "tool-utils",
                "tool-web",
                "ui",
                "ui-kit",
                "tool-mail-ui",
                "tool-calendar-ui",
                "github-ui",
                "chat-discord-ui",
                "chat-whatsapp-ui"
            ]
        },
        {
            "type": "node-workspace",
            "updateAllPackages": true,
            "updatePeerDependencies": true
        }
    ]
}
