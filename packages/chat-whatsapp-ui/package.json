{
    "name": "@chamvi/chat-whatsapp-ui",
    "version": "0.12.0",
    "type": "module",
    "description": "The WhatsApp page of the chamvi dashboard: pair, watch and reset WhatsApp connections.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/chat-whatsapp-ui"
    },
    "exports": {
        "./package.json": "./package.json",
        "./module": {
            "types": "./dist/module.d.mts",
            "import": "./dist/module.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "build:types": "vue-tsc --noEmit -p tsconfig.json",
        "build:js": "tsdown",
        "build:app": "vite build",
        "build": "npm run build:types && npm run build:js && npm run build:app",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage",
        "test:e2e": "playwright test"
    },
    "keywords": [
        "chamvi",
        "dashboard",
        "whatsapp",
        "agent"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "devDependencies": {
        "@chamvi/app": "^0.12.0",
        "@chamvi/core": "^0.12.0",
        "@chamvi/http": "^0.12.0",
        "@chamvi/http-kit": "^0.12.0",
        "@chamvi/ui": "^0.12.0",
        "@chamvi/ui-kit": "^0.12.0",
        "@playwright/test": "^1.65.1",
        "ai": "^7.0.181",
        "happy-dom": "^21.0.4",
        "uqr": "^0.1.3",
        "vite": "^8.3.8",
        "vue": "^3.5.46",
        "vue-tsc": "^3.3.14"
    },
    "peerDependencies": {
        "@chamvi/app": "^0.12.0"
    },
    "peerDependenciesMeta": {
        "@chamvi/app": {
            "optional": true
        }
    }
