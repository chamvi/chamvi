{
    "name": "@chamvi/tool-mail",
    "version": "0.8.0",
    "type": "module",
    "description": "Read-only mail tools for chamvi agents: search, read and thread mails and extract attachment text over IMAP, without ever changing a mailbox.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/tool-mail"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./module": {
            "types": "./dist/module.d.mts",
            "import": "./dist/module.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamvi",
        "mail",
        "imap",
        "email",
        "tools",
        "agent"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "fflate": "0.8.3",
        "imapflow": "2.11.0",
        "postal-mime": "4.2.0",
        "smob": "^1.6.2",
        "unpdf": "2.1.0"
    },
    "devDependencies": {
        "@chamvi/app": "^0.8.0",
        "@chamvi/core": "^0.8.0",
        "@chamvi/http": "^0.8.0",
        "@chamvi/test-kit": "^0.8.0",
        "ai": "^7.0.165"
    },
    "peerDependencies": {
        "@chamvi/app": "^0.8.0",
        "@chamvi/core": "^0.8.0",
        "ai": "^7"
    },
    "peerDependenciesMeta": {
        "@chamvi/app": {
            "optional": true
        }
    }
}
