  "listed state_write{name:vault} POST /runs/<vault>/cancel": {
    "body": {
      "code": "forbidden",
      "message": "Missing permission "chamvi_run_cancel".",
      "status": 403,
    },
    "status": 403,
  },
  "listed state_write{name:vault} PUT /connections/mail-work/config {}": {
    "body": {
      "code": "forbidden",
      "message": "Missing permission "chamvi_connection_write".",
      "status": 403,
    },
    "status": 403,
  },
}
`;

