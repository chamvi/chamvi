{
    "name": "@chamvi/http",
    "version": "0.9.0",
    "type": "module",
    "description": "REST, SSE, webhooks and MCP for chamvi agents, on routup.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/http"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build:swagger": "trapi generate",
        "build": "npm run build:types && npm run build:js && npm run build:swagger",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "nx": {
        "targets": {
            "test": {
                "dependsOn": [
                    "build"
                ]
            }
        }
    },
    "keywords": [
        "chamvi",
        "http",
        "rest",
        "sse",
        "mcp",
        "webhook",
        "routup"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@authup/access": "^1.0.0-beta.75",
        "@authup/server-adapter-kit": "^1.0.0-beta.75",
        "@authup/server-adapter-web": "^1.0.0-beta.75",
        "@chamvi/access": "^0.9.0",
        "@ebec/core": "^1.3.2",
        "@ebec/http": "^4.3.2",
        "@modelcontextprotocol/server": "^2.4.0",
        "@rapiq/codec-url": "^2.4.0",
        "@rapiq/core": "^2.4.0",
        "@rapiq/parser-expression": "^2.4.0",
        "@rapiq/parser-simple": "^2.4.0",
        "@routup/body": "^4.0.1",
        "@routup/cors": "^2.0.1",
        "@routup/decorators": "^5.0.2",
        "@routup/prometheus": "^4.0.1",
        "@routup/rate-limit": "^4.0.2",
        "@routup/swagger-ui": "^4.0.2",
        "@standard-schema/spec": "^1.1.0",
        "@validup/standard-schema": "^2.0.2",
        "cron-parser": "^5.10.4",
        "prom-client": "^15.1.3",
        "routup": "^6.1.1",
        "smob": "^1.6.2",
        "validup": "^2.0.1",
        "vouchly": "^0.1.1"
    },
    "devDependencies": {
        "@chamvi/core": "^0.9.0",
        "@chamvi/test-kit": "^0.8.1",
        "@modelcontextprotocol/client": "^2.4.0",
        "@swc/core": "^1.16.22",
        "@trapi/cli": "^2.2.0",
        "@trapi/core": "^2.2.0",
        "ai": "^7.0.165",
        "ajv": "^8.20.0",
        "jose": "^6.2.15",
        "unplugin-swc": "^2.0.0",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "@chamvi/core": "^0.9.0"
    }
}
