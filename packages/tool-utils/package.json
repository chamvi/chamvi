{
    "name": "@chamvi/tool-utils",
    "version": "0.9.0",
    "type": "module",
    "description": "Utility tools for chamvi agents: the current time, date arithmetic, exact calculation and run info a model cannot do reliably itself.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/tool-utils"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamvi",
        "time",
        "date",
        "calculator",
        "tools",
        "agent"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "decimal.js": "^10.6.0",
        "smob": "^1.6.2"
    },
    "devDependencies": {
        "@chamvi/core": "^0.9.0",
        "@chamvi/test-kit": "^0.8.1",
        "ai": "^7.0.165"
    },
    "peerDependencies": {
        "@chamvi/core": "^0.9.0",
        "ai": "^7"
    }
}
