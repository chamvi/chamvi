{
    "name": "@chamvi/store",
    "version": "0.9.0",
    "type": "module",
    "description": "The storage contract of chamvi: the stored record types, the generic entity repository port and the storage errors its drivers report.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/store"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamvi",
        "store",
        "repository",
        "storage"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@chamvi/access": "^0.9.0",
        "@ebec/core": "^1.3.2",
        "@rapiq/core": "^2.4.1"
    },
    "devDependencies": {
        "ai": "^7.0.165"
    },
    "peerDependencies": {
        "ai": "^7"
    },
    "peerDependenciesMeta": {
        "ai": {
            "optional": true
        }
    }
}
