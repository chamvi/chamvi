{
    "name": "@chamvi/test-kit",
    "version": "0.9.0",
    "type": "module",
    "description": "Test helpers for chamvi: a controllable clock, an engine on memory repositories, a test data source for an app's database, the store and workspace contract suites, a git fixture and a fake GitHub.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/test-kit"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "nx": {
        "targets": {
            "test": {
                "dependsOn": [
                    "build"
                ]
            }
        }
    },
    "keywords": [
        "chamvi",
        "testing",
        "store",
        "contract",
        "github",
        "fake"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@chamvi/store": "^0.9.0",
        "@chamvi/store-memory": "^0.9.0",
        "@rapiq/core": "^2.4.1",
        "smob": "^1.6.2"
    },
    "devDependencies": {
        "@chamvi/core": "^0.9.0",
        "ai": "^7.0.165",
        "better-sqlite3": "^12.11.1",
        "pg": "^8.23.1",
        "typeorm": "^1.1.2"
    },
    "peerDependencies": {
        "@chamvi/core": "^0.9.0",
        "ai": "^7",
        "better-sqlite3": "^12.11.1",
        "pg": "^8",
        "typeorm": "^1.1.2",
        "vitest": "^5"
    },
    "peerDependenciesMeta": {
        "better-sqlite3": {
            "optional": true
        },
        "pg": {
            "optional": true
        },
        "typeorm": {
            "optional": true
        }
    }
}
