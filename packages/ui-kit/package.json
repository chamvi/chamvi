{
    "name": "@chamvi/ui-kit",
    "version": "0.8.0",
    "type": "module",
    "description": "The shared base of the chamvi dashboard and its *-ui pages: API client, session, shell pieces, connection components and the page bootstrap.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/ui-kit"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./vite": {
            "types": "./dist/vite/index.d.ts",
            "import": "./dist/vite.mjs"
        },
        "./style.css": "./dist/style.css"
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "build:js": "tsdown",
        "build:types": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
        "build": "npm run build:js && npm run build:types",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamvi",
        "dashboard",
        "ui-kit",
        "vue",
        "agent"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
