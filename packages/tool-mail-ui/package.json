{
    "name": "@chamvi/tool-mail-ui",
    "version": "0.9.0",
    "type": "module",
    "description": "The Mail page of the chamvi dashboard: configure mail connections.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/tool-mail-ui"
    },
    "exports": {
        "./package.json": "./package.json",
        "./module": {
            "types": "./dist/module.d.mts",
            "import": "./dist/module.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build:app": "vite build",
        "build": "npm run build:types && npm run build:js && npm run build:app",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage",
        "test:e2e": "playwright test"
    },
    "keywords": [
        "chamvi",
        "dashboard",
        "mail",
        "agent"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "devDependencies": {
        "@chamvi/app": "^0.9.0",
        "@chamvi/core": "^0.9.0",
        "@chamvi/http": "^0.9.0",
        "@chamvi/tool-mail": "^0.9.0",
        "@chamvi/ui": "^0.9.0",
        "@chamvi/ui-kit": "^0.9.0",
        "@playwright/test": "^1.65.0",
        "ai": "^7.0.165",
        "vite": "^8.3.6",
        "vue": "^3.5.45",
        "vue-tsc": "^3.3.14"
    },
    "peerDependencies": {
        "@chamvi/app": "^0.9.0"
    },
    "peerDependenciesMeta": {
        "@chamvi/app": {
            "optional": true
        }
    }
}
