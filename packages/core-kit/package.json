{
    "name": "@chamvi/core-kit",
    "version": "0.13.0",
    "type": "module",
    "description": "chamvi's domain records: runs, steps, checkpoints, triggers, approvals, artifacts, connections, conversations and state, shared by server and clients.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/core-kit"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamvi",
        "domain-model",
        "types",
        "records"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@chamvi/access": "^0.12.1",
        "@validup/zod": "^2.0.3",
        "smob": "^1.6.2",
        "validup": "^2.0.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "ai": "^7.0.181"
    },
    "peerDependencies": {
        "ai": "^7"
    },
    "peerDependenciesMeta": {
        "ai": {
            "optional": true
        }
    }
}
