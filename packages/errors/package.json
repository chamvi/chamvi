{
    "name": "@chamvi/errors",
    "version": "0.13.0",
    "type": "module",
    "description": "chamvi's error classes, error codes and code-to-HTTP-status mapping, with guards that survive JSON.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/errors"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamvi",
        "error",
        "error-codes",
        "http-error"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@ebec/core": "^1.3.2"
    }
}
