{
    "name": "@chamvi/chat-whatsapp",
    "version": "0.9.0",
    "type": "module",
    "description": "WhatsApp Web on Baileys as a chat channel for chamvi agents.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/chat-whatsapp"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./module": {
            "types": "./dist/module.d.mts",
            "import": "./dist/module.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamvi",
        "chat",
        "whatsapp",
        "baileys",
        "channel"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "smob": "^1.6.2"
    },
    "devDependencies": {
        "@chamvi/app": "^0.9.0",
        "@chamvi/chat": "^0.9.0",
        "@chamvi/core": "^0.9.0",
        "@chamvi/store-db": "^0.8.1",
        "@chamvi/test-kit": "^0.8.1",
        "@swc/core": "^1.16.22",
        "@testcontainers/postgresql": "^12.2.1",
        "ai": "^7.0.165",
        "baileys": "7.0.0-rc14",
        "chat": "^4.44.0",
        "pg": "^8.23.1",
        "typeorm": "^1.1.2",
        "typeorm-extension": "^4.3.0",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "@chamvi/app": "^0.9.0",
        "@chamvi/chat": "^0.9.0",
        "@chamvi/core": "^0.9.0",
        "baileys": "7.0.0-rc14",
        "chat": "^4.44.0"
    },
    "peerDependenciesMeta": {
        "@chamvi/app": {
            "optional": true
        }
    }
}
