{
    "name": "@chamvi/store-db-vector",
    "version": "0.10.1",
    "type": "module",
    "description": "pgvector store for chamvi knowledge collections: the tables, migrations and repositories on PostgreSQL.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/store-db-vector"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamvi",
        "knowledge",
        "pgvector",
        "postgres",
        "typeorm"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "devDependencies": {
        "@chamvi/app": "^0.10.1",
        "@chamvi/core": "^0.10.1",
        "@chamvi/knowledge": "^0.10.1",
        "@chamvi/store": "^0.10.1",
        "@chamvi/store-db": "^0.10.1",
        "@chamvi/test-kit": "^0.10.1",
        "@swc/core": "^1.16.22",
        "@testcontainers/postgresql": "^12.2.1",
        "ai": "^7.0.173",
        "pg": "^8.23.1",
        "typeorm": "^1.1.3",
        "typeorm-extension": "^4.6.0",
        "unplugin-swc": "^2.0.0"
    },
    "peerDependencies": {
        "@chamvi/app": "^0.10.1",
        "@chamvi/core": "^0.10.1",
        "@chamvi/knowledge": "^0.10.1",
        "@chamvi/store": "^0.10.1",
        "@chamvi/store-db": "^0.10.1",
        "pg": "^8",
        "typeorm": "^1.1.3"
    }
}
