{
    "name": "@chamvi/tool-calendar",
    "version": "0.7.3",
    "type": "module",
    "description": "Read-only calendar tools for chamvi agents: list calendars and expanded events over CalDAV, without ever changing a calendar.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/tool-calendar"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./module": {
            "types": "./dist/module.d.mts",
            "import": "./dist/module.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamvi",
        "calendar",
        "caldav",
        "ical",
        "tools",
        "agent"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "ical.js": "2.2.1",
        "smob": "^1.6.2",
        "tsdav": "2.5.0"
    },
    "devDependencies": {
        "@chamvi/app": "^0.7.3",
        "@chamvi/core": "^0.7.3",
        "@chamvi/http": "^0.7.3",
        "@chamvi/test-kit": "^0.7.3",
        "ai": "^7.0.163"
    },
    "peerDependencies": {
        "@chamvi/app": "^0.7.3",
        "@chamvi/core": "^0.7.3",
        "ai": "^7"
    },
    "peerDependenciesMeta": {
        "@chamvi/app": {
            "optional": true
        }
    }
}
