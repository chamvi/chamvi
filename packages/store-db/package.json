{
    "name": "@chamvi/store-db",
    "version": "0.10.0",
    "type": "module",
    "description": "Database store for chamvi (PostgreSQL), with TypeORM repositories for durable runs, leases and agent state.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "homepage": "https://chamvi.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/chamvi/chamvi.git",
        "directory": "packages/store-db"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "NOTICE"
    ],
    "engines": {
        "node": ">=26.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit -p tsconfig.build.json",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage"
    },
    "keywords": [
        "chamvi",
        "store",
        "postgres",
        "typeorm"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@chamvi/store": "^0.10.0",
        "@ebec/core": "^1.3.2",
        "@rapiq/adapter-sql": "^2.5.1",
        "@rapiq/adapter-typeorm": "^2.5.1",
        "@rapiq/core": "^2.5.1",
        "smob": "^1.6.2",
        "typeorm-extension": "^4.6.0",
        "uuidv7": "^1.2.1"
    },
    "devDependencies": {
        "@chamvi/core": "^0.10.0",
        "@chamvi/store-memory": "^0.10.0",
        "@chamvi/test-kit": "^0.10.0",
        "@swc/core": "^1.16.22",
        "@testcontainers/postgresql": "^12.2.2",
        "@types/better-sqlite3": "^7.6.13",
        "ai": "^7.0.181",
        "better-sqlite3": "^12.11.1",
        "pg": "^8.23.1",
        "typeorm": "^1.1.3",
        "unplugin-swc": "^2.0.0",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "better-sqlite3": "^12.11.1",
        "pg": "^8",
        "typeorm": "^1.1.3"
    },
    "peerDependenciesMeta": {
        "better-sqlite3": {
            "optional": true
        }
    }
}
